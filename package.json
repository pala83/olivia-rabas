{
	"name": "olivia-rabas",
	"private": true,
	"type": "module",
	"workspaces": [
		"client",
		"api"
	],
	"scripts": {
		"dev": "bun --filter '*' dev",
		"dev:api": "bun --filter @olivia-rabas/api dev",
		"dev:client": "bun --filter @olivia-rabas/client dev",
		"test": "bun --filter @olivia-rabas/api test",
		"check": "biome check .",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"check:fix": "biome check --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8"
	}
}
